# Copia aquest fitxer com a ".env" i omple els valors.

# Port de l'aplicació web
PORT=3000

# Contrasenya per entrar a l'app (recomanat si és accessible des d'internet).
# Usuari: qualsevol. Deixa-ho buit per no demanar contrasenya.
APP_PASSWORD=

# --- Lectura automàtica de les fotos (Claude) ---
# Clau de https://console.anthropic.com  (sense clau, les línies s'entren a mà)
ANTHROPIC_API_KEY=

# --- Enviament de correus (SMTP) ---
# Exemple amb Gmail: cal activar la verificació en 2 passos i crear una
# "contrasenya d'aplicació" a https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitent (per defecte, SMTP_USER) i còpia opcional de tots els correus
MAIL_FROM=
MAIL_CC=

# Carpeta on es guarden les dades i les fotos (per defecte ./data)
DATA_DIR=
