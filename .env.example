# Copia aquest fitxer com a ".env" i omple els valors.

PORT=3000

# Contrasenya per entrar a l'app (obligatòria a Vercel)
APP_PASSWORD=

# --- Supabase ---
# Base de dades: Supabase > Connect > "Transaction pooler" (cadena URI, port 6543). Substitueix [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Si l'app comparteix projecte de Supabase, nom de l'esquema propi (l'usuari de DATABASE_URL hi ha d'apuntar)
DB_SCHEMA=
# Fotos (Storage): Supabase > Project Settings > API Keys > secret
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Nom del bucket on es guarden les fotos (es crea sol, privat)
SUPABASE_BUCKET=comandes-fotos

# --- Lectura automàtica de les fotos (Claude) ---
ANTHROPIC_API_KEY=

# --- Correu: els correus surten de jordi@tecaxerinola.com ---
# Dades SMTP del compte jordi@tecaxerinola.com.
#  · Google Workspace / Gmail: smtp.gmail.com, port 465, i una "contrasenya d'aplicació"
#    (https://myaccount.google.com/apppasswords, cal la verificació en 2 passos).
#  · Microsoft 365: smtp.office365.com, port 587.
#  · Altres (hosting): les dades SMTP que dona el proveïdor del domini.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jordi@tecaxerinola.com
SMTP_PASS=
# Còpia opcional de tots els correus enviats
MAIL_CC=
