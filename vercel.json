{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/seed-data.json,supabase/migrations/**,public/logo.jpg,node_modules/pdfkit/js/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/photos/(.*)", "destination": "/api" }
  ]
}
